# BidSure AI - Environment Configuration Example
# Copy this file to .env or .env.local to customize local configuration
# NOTE: Never commit sensitive tokens, secrets, or credentials to git.

# Backend Configuration (Flask)
FLASK_ENV=development
FLASK_APP=app.py
PORT=5000
HOST=127.0.0.1

# AI Intelligence Engine
# Options: 'local_ollama' or 'deterministic_engine'
AI_ENGINE_MODE=deterministic_engine
OLLAMA_API_URL=http://localhost:11434/api/generate

# Frontend Configuration (Vite / React)
VITE_API_BASE_URL=/api
VITE_ENABLE_AUDIO_VOICEOVER=true
